FROM lostcacher/base-projects:latest

COPY requirements-web.txt /tmp/quella-requirements.txt
RUN pip install --no-cache-dir -r /tmp/quella-requirements.txt

WORKDIR /srv/docker/projects/osmofresh-quella-pro
CMD ["uvicorn", "web_app.main:app", "--host", "0.0.0.0", "--port", "8001", "--proxy-headers", "--forwarded-allow-ips", "*"]

